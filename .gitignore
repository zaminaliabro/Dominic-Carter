# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (npm install se dobara ban jate hain)
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js build output
/.next/
/out/

# production
/build

# env files - passwords / API keys yahan hote hain, kabhi upload na karein
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# keys / certificates
*.pem
*.key

# OS files (Windows / Mac)
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# editors
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo

# local Claude Code settings
.claude/settings.local.json

# temp files
*.tmp
*.temp
.cache/
